# Copy to .env and fill in real values. See README.md > Environment Variables for a grouped explanation.

# --- App ---
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL (primary relational store) ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- MongoDB (onboarding docs + vector embeddings) ---
MONGO_URI=
MONGO_DB=

# --- Redis (BullMQ queues + cache/lock primitives) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=
JWT_REFRESH_SECRET=
ATTENDANCE_JWT_SECRET=
ATTENDANCE_JWT_EXPIRATION=1h

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/auth/google/callback

# --- RabbitMQ (event bus between API process and worker process) ---
RABBITMQ_URL=amqp://localhost:5672
RMQ_MOOD_QUEUE=mood-tasks
RMQ_MOOD_EXCHANGE=mood-exchange
RMQ_COMM_QUEUE=community-tasks
RMQ_COMM_EXCHANGE=community-exchange
RMQ_REC_QUEUE=recommendation-tasks
RMQ_REC_EXCHANGE=recommendation-exchange
RMQ_ONBOARDING_QUEUE=onboarding-tasks
RMQ_ONBOARDING_EXCHANGE=onboarding-exchange
RMQ_EXP_QUEUE=experience-tasks
RMQ_EXP_EXCHANGE=experience-exchange

# --- AI / Inference ---
GEMINI_API_KEY=
OPENAI_API_KEY=
RANKING_PROVIDER=openai
FASTAPI_URL=
HF_TOKEN=

# --- AWS S3 (image/avatar storage) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_BASE_URL=
EXPERIENCE_IMAGES_CDN_URL=
UPLOADS_DIR=./uploads

# --- Email (Nodemailer, sent via BullMQ notification-queue) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=logs
